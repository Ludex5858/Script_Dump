local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local DownedCharacters = workspace:WaitForChild("DownedCharacters")

local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local Root = Character:WaitForChild("HumanoidRootPart")
local Animator = Humanoid:WaitForChild("Animator")
local Carry = Character:WaitForChild("StateHandler"):WaitForChild("CarryAnotherPlayer")

local CarryUI = Player.PlayerGui:WaitForChild("PlayerGUI"):WaitForChild("CarryUI")
local Buttons = CarryUI:WaitForChild("ButtonUI")
local ReviveBar = Buttons:WaitForChild("ReviveBar")
local ReviveProgress = ReviveBar:WaitForChild("ReviveProgress")

local CarryHandler = CarryUI:WaitForChild("CarryHandler")
local HighlightTemplate = CarryHandler:WaitForChild("DownedHighlight")

local Animations = ReplicatedStorage
	:WaitForChild("GeneralAssets")
	:WaitForChild("Animations")
	:WaitForChild("CarryAnimations")
	:WaitForChild(Player:GetAttribute("CarryAnimation"))

local CarryAnimation = Animator:LoadAnimation(Animations:WaitForChild("Carry"))
local CarriedAnimation = Animator:LoadAnimation(Animations:WaitForChild("Carried"))

CarryHandler.Disabled = true
HighlightTemplate.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

local RANGE = 8
local DEBOUNCE = 0.2

local Target = nil
local ReviveTarget = nil
local CarryDebounce = false
local Objects = {}

local RangeFolder = Instance.new("Folder")
RangeFolder.Name = "CarryRange"
RangeFolder.Parent = workspace

local ReviveTween = TweenService:Create(
	ReviveProgress,
	TweenInfo.new(Humanoid:GetAttribute("ReviveTime"), Enum.EasingStyle.Linear),
	{ Size = UDim2.fromScale(0, 1) }
)

local function removeObjects(character)
	local objects = Objects[character]

	if not objects then
		return
	end

	if objects.Box then
		objects.Box:Destroy()
	end

	if objects.Highlight then
		objects.Highlight:Destroy()
	end

	Objects[character] = nil
end

local function addObjects(character)
	if character == Character or Objects[character] then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChild("Humanoid")

	if not root or not humanoid or humanoid:GetAttribute("Downed") ~= true then
		return
	end

	local box = Instance.new("BoxHandleAdornment")
	box.Name = "CarryRange"
	box.Adornee = root
	box.Size = Vector3.new(RANGE * 2, RANGE * 2, RANGE * 2)
	box.Transparency = 0.8
	box.Color3 = Color3.fromRGB(255, 170, 0)
	box.AlwaysOnTop = false
	box.Parent = RangeFolder

	local highlight = HighlightTemplate:Clone()
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = Color3.fromRGB(255, 0, 0)
	highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
	highlight.Parent = character

	Objects[character] = {
		Box = box,
		Highlight = highlight
	}

	humanoid:GetAttributeChangedSignal("Downed"):Connect(function()
		if humanoid:GetAttribute("Downed") == true
			and character:IsDescendantOf(DownedCharacters)
		then
			return
		end

		if Target == character then
			Target = nil
		end

		removeObjects(character)
	end)
end

local function selectTarget(character)
	if Target == character then
		return
	end

	if Target and Objects[Target] then
		local oldHighlight = Objects[Target].Highlight

		if oldHighlight then
			oldHighlight.FillColor = Color3.fromRGB(255, 0, 0)
			oldHighlight.OutlineColor = Color3.fromRGB(255, 0, 0)
		end
	end

	Target = character

	if Target and Objects[Target] then
		local highlight = Objects[Target].Highlight

		highlight.FillColor = Color3.fromRGB(0, 255, 0)
		highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
	end
end

local function clearTarget()
	if Target and Objects[Target] then
		local highlight = Objects[Target].Highlight

		if highlight then
			highlight.FillColor = Color3.fromRGB(255, 0, 0)
			highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
		end
	end

	Target = nil
end

local function revive()
	if not Target or ReviveTarget then
		return
	end

	local state = Target:FindFirstChild("StateHandler")
	local attempt = state and state:FindFirstChild("AttemptRevive")

	if not attempt or not attempt:InvokeServer() then
		return
	end

	ReviveTarget = Target
	ReviveProgress.Size = UDim2.fromScale(1, 1)
	ReviveBar.Visible = true
	ReviveTween:Play()

	task.spawn(function()
		while ReviveTarget do
			task.wait(0.1)

			local target = ReviveTarget
			local root = target:FindFirstChild("HumanoidRootPart")
			local humanoid = target:FindFirstChild("Humanoid")

			if not root
				or not humanoid
				or not target:IsDescendantOf(DownedCharacters)
				or humanoid:GetAttribute("Downed") ~= true
				or not humanoid:GetAttribute("BeingRevived")
				or (Root.Position - root.Position).Magnitude > RANGE
				or Humanoid:GetAttribute("Downed")
				or Humanoid:GetAttribute("Ragdolled")
				or Humanoid:GetState() == Enum.HumanoidStateType.Dead
			then
				ReviveTarget = nil
				ReviveTween:Cancel()
				ReviveProgress.Size = UDim2.fromScale(1, 1)
				ReviveBar.Visible = false
				return
			end
		end
	end)
end

ReviveTween.Completed:Connect(function(state)
	if state == Enum.PlaybackState.Completed then
		ReviveTarget = nil
		ReviveBar.Visible = false
	end
end)

local function carry()
	if CarryDebounce then
		return
	end

	CarryDebounce = true

	task.delay(DEBOUNCE, function()
		CarryDebounce = false
	end)

	if Target then
		Carry:FireServer(Target)
	elseif Humanoid:GetAttribute("Carrying") then
		Carry:FireServer()
	end
end

Buttons.ReviveButton.MouseButton1Click:Connect(revive)
Buttons.CarryButton.MouseButton1Click:Connect(carry)
Buttons.DropButton.MouseButton1Click:Connect(carry)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then
		return
	end

	if input.KeyCode == Enum.KeyCode.Q then
		carry()
	elseif input.KeyCode == Enum.KeyCode.E then
		revive()
	end
end)

DownedCharacters.ChildAdded:Connect(function(character)
	task.wait()

	if character:IsDescendantOf(DownedCharacters) then
		addObjects(character)
	end
end)

DownedCharacters.ChildRemoved:Connect(function(character)
	if Target == character then
		Target = nil
	end

	if ReviveTarget == character then
		ReviveTarget = nil
		ReviveTween:Cancel()
		ReviveProgress.Size = UDim2.fromScale(1, 1)
		ReviveBar.Visible = false
	end

	removeObjects(character)
end)

for _, character in ipairs(DownedCharacters:GetChildren()) do
	addObjects(character)
end

task.spawn(function()
	while task.wait(0.2) do
		for character in pairs(Objects) do
			if not character:IsDescendantOf(DownedCharacters) then
				if Target == character then
					Target = nil
				end

				if ReviveTarget == character then
					ReviveTarget = nil
					ReviveTween:Cancel()
					ReviveProgress.Size = UDim2.fromScale(1, 1)
					ReviveBar.Visible = false
				end

				removeObjects(character)
			end
		end
	end
end)

Humanoid:GetAttributeChangedSignal("Carried"):Connect(function()
	if Humanoid:GetAttribute("Carried") then
		CarriedAnimation:Play()
	else
		CarriedAnimation:Stop()
	end
end)

Humanoid:GetAttributeChangedSignal("Carrying"):Connect(function()
	if Humanoid:GetAttribute("Carrying") then
		CarryAnimation:Play()
	else
		CarryAnimation:Stop()
	end
end)

while task.wait(0.05) do
	local closest = nil
	local closestDistance = RANGE

	local free =
		Humanoid:GetAttribute("Downed") ~= true
		and Humanoid:GetState() ~= Enum.HumanoidStateType.Dead
		and not Player:GetAttribute("Ghost")
		and Humanoid:GetAttribute("Ragdolled") ~= true

	if free then
		for character in pairs(Objects) do
			local root = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChild("Humanoid")

			if root
				and humanoid
				and character:IsDescendantOf(DownedCharacters)
				and humanoid:GetAttribute("Downed") == true
				and humanoid:GetState() ~= Enum.HumanoidStateType.Dead
				and not humanoid:GetAttribute("Carried")
				and not humanoid:GetAttribute("Ragdolled")
			then
				local distance = (Root.Position - root.Position).Magnitude

				if distance <= closestDistance then
					closest = character
					closestDistance = distance
				end
			end
		end
	end

	selectTarget(closest)

	if Target then
		Buttons.Visible = true
		Buttons.CarryButton.Visible = true
		Buttons.ReviveButton.Visible = true
		Buttons.DropButton.Visible = false
	elseif Humanoid:GetAttribute("Carrying") then
		Buttons.Visible = true
		Buttons.CarryButton.Visible = false
		Buttons.ReviveButton.Visible = false
		Buttons.DropButton.Visible = true
	else
		Buttons.Visible = false
	end
end
