local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local DownedCharacters = workspace:WaitForChild("DownedCharacters")

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Animator = Humanoid:WaitForChild("Animator")
local Carry = Character:WaitForChild("StateHandler"):WaitForChild("CarryAnotherPlayer")

local CarryUI = LocalPlayer.PlayerGui:WaitForChild("PlayerGUI"):WaitForChild("CarryUI")
local ButtonUI = CarryUI:WaitForChild("ButtonUI")
local ReviveBar = ButtonUI:WaitForChild("ReviveBar")
local ReviveProgress = ReviveBar:WaitForChild("ReviveProgress")

local CarryHandler = CarryUI:WaitForChild("CarryHandler")
local Highlight = CarryHandler:WaitForChild("DownedHighlight")

local CarryAnimations = ReplicatedStorage
	:WaitForChild("GeneralAssets")
	:WaitForChild("Animations")
	:WaitForChild("CarryAnimations")
	:WaitForChild(LocalPlayer:GetAttribute("CarryAnimation"))

local CarryAnim = Animator:LoadAnimation(CarryAnimations:WaitForChild("Carry"))
local CarriedAnim = Animator:LoadAnimation(CarryAnimations:WaitForChild("Carried"))

CarryHandler.Disabled = true
Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

local RANGE = 8
local DEBOUNCE = 0.5

local Target = nil
local ReviveTarget = nil
local CarryDebounce = false

local ReviveTween = TweenService:Create(
	ReviveProgress,
	TweenInfo.new(Humanoid:GetAttribute("ReviveTime"), Enum.EasingStyle.Linear),
	{ Size = UDim2.fromScale(0, 1) }
)

local RangeFolder = Instance.new("Folder")
RangeFolder.Name = "CarryRange"
RangeFolder.Parent = workspace

local function addRange(character)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or root:FindFirstChild("CarryRange") then
		return
	end

	local box = Instance.new("BoxHandleAdornment")
	box.Name = "CarryRange"
	box.Adornee = root
	box.Size = Vector3.new(RANGE * 2, RANGE * 2, RANGE * 2)
	box.Transparency = 0.8
	box.Color3 = Color3.fromRGB(255, 170, 0)
	box.AlwaysOnTop = false
	box.Parent = RangeFolder
end

local function removeRange(character)
	local root = character:FindFirstChild("HumanoidRootPart")
	local box = root and root:FindFirstChild("CarryRange")

	if box then
		box:Destroy()
	end
end

for _, character in ipairs(DownedCharacters:GetChildren()) do
	addRange(character)
end

DownedCharacters.ChildAdded:Connect(function(character)
	character:WaitForChild("HumanoidRootPart", 3)
	addRange(character)
end)

DownedCharacters.ChildRemoved:Connect(removeRange)

Humanoid:GetAttributeChangedSignal("Carried"):Connect(function()
	if Humanoid:GetAttribute("Carried") then
		CarriedAnim:Play()
	else
		CarriedAnim:Stop()
	end
end)

Humanoid:GetAttributeChangedSignal("Carrying"):Connect(function()
	if Humanoid:GetAttribute("Carrying") then
		CarryAnim:Play()
	else
		CarryAnim:Stop()
	end
end)

local function revive()
	if not Target or ReviveTarget then
		return
	end

	local state = Target:FindFirstChild("StateHandler")
	local attempt = state and state:FindFirstChild("AttemptRevive")

	if not attempt or not attempt:InvokeServer() then
		return
	end

	ReviveTarget = Target
	ReviveProgress.Size = UDim2.fromScale(1, 1)
	ReviveBar.Visible = true
	ReviveTween:Play()

	task.spawn(function()
		while ReviveTarget do
			task.wait(0.1)

			local root = ReviveTarget:FindFirstChild("HumanoidRootPart")
			local humanoid = ReviveTarget:FindFirstChild("Humanoid")

			if not root
				or not humanoid
				or (RootPart.Position - root.Position).Magnitude > RANGE
				or not humanoid:GetAttribute("BeingRevived")
				or not humanoid:GetAttribute("Downed")
			then
				ReviveTarget = nil
				ReviveTween:Cancel()
				ReviveBar.Visible = false
				break
			end
		end
	end)
end

ReviveTween.Completed:Connect(function(state)
	if state == Enum.PlaybackState.Completed then
		ReviveTarget = nil
		ReviveBar.Visible = false
	end
end)

local function carry()
	if CarryDebounce then
		return
	end

	CarryDebounce = true
	task.delay(DEBOUNCE, function()
		CarryDebounce = false
	end)

	if Target then
		Carry:FireServer(Target)
	elseif Humanoid:GetAttribute("Carrying") then
		Carry:FireServer()
	end
end

ButtonUI.ReviveButton.MouseButton1Click:Connect(revive)
ButtonUI.CarryButton.MouseButton1Click:Connect(carry)
ButtonUI.DropButton.MouseButton1Click:Connect(carry)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then
		return
	end

	if input.KeyCode == Enum.KeyCode.Q then
		carry()
	elseif input.KeyCode == Enum.KeyCode.E then
		revive()
	end
end)

while task.wait(0.2) do
	local closest
	local distance = RANGE

	local free =
		not Humanoid:GetAttribute("Downed")
		and Humanoid:GetState() ~= Enum.HumanoidStateType.Dead
		and not LocalPlayer:GetAttribute("Ghost")
		and not Humanoid:GetAttribute("Ragdolled")

	if free then
		for _, character in ipairs(DownedCharacters:GetChildren()) do
			local root = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChild("Humanoid")

			if root and humanoid then
				local dist = (RootPart.Position - root.Position).Magnitude

				if dist <= distance
					and humanoid:GetState() ~= Enum.HumanoidStateType.Dead
					and not humanoid:GetAttribute("Carried")
					and not humanoid:GetAttribute("Ragdolled")
				then
					closest = character
					distance = dist
				end
			end
		end
	end

	if closest ~= Target then
		if Target then
			local oldHighlight = Target:FindFirstChild("DownedHighlight")
			if oldHighlight then
				oldHighlight:Destroy()
			end
		end

		Target = closest

		if Target then
			Highlight:Clone().Parent = Target

			ButtonUI.Visible = true
			ButtonUI.CarryButton.Visible = true
			ButtonUI.ReviveButton.Visible = true
			ButtonUI.DropButton.Visible = false
		else
			if Humanoid:GetAttribute("Carrying") then
				ButtonUI.Visible = true
				ButtonUI.CarryButton.Visible = false
				ButtonUI.ReviveButton.Visible = false
				ButtonUI.DropButton.Visible = true
			else
				ButtonUI.Visible = false
			end
		end
	end
end
