    addResult("========================================")
    task.wait(0.3)
    
    testMethod("Find All Collectibles", function()
        local ids = findAllCollectibles()
        addResult("Found " .. #ids .. " total collectible entries")
        return true
    end)
    
    testMethod("Remote Event", function()
        return testRemoteEvents() ~= nil
    end)
    
    testMethod("FireServer Methods", testFireServerMethods)
    testMethod("Get All IDs", testGetAllIds)
    testMethod("Teleport to Collectible", testTeleportCollect)
    testMethod("Collect Nearby", testCollectNearby)
    
    addResult("========================================")
    addResult("TESTING COMPLETE")
    addResult("========================================")
    addResult("Copy these results and paste them back")
    addResult("to get the final working script")
    addResult("========================================")
    
    statusText.Text = "Status: Testing complete! Select all text to copy."
end

