local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local CollectibleStream = ReplicatedStorage:WaitForChild("MogOrDie"):WaitForChild("CollectibleStream")

local COLLECT_RADIUS = 999999
local AUTO_COOLDOWN = 0.01

local collectedIds = {}

local function collectItem(id)
    if collectedIds[id] then return end
    collectedIds[id] = true
    CollectibleStream:FireServer("collect", id)
    task.wait(0.005)
end

local function getAllCollectibles()
    local found = {}
    
    local clientCollectibles = Workspace:FindFirstChild("ClientCollectibles")
    if clientCollectibles then
        for _, child in pairs(clientCollectibles:GetDescendants()) do
            if child:IsA("Model") or child:IsA("Part") or child:IsA("Folder") then
                local id = child:GetAttribute("CollectibleId") or child.Name
                if id and id ~= "" and not found[id] then
                    found[id] = true
                    collectItem(id)
                end
            end
        end
    end
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") or v:IsA("Part") then
            local id = v:GetAttribute("CollectibleId") or v.Name
            if id and id ~= "" and not found[id] then
                found[id] = true
                collectItem(id)
            end
        end
    end
end

while wait(0.5) do
    getAllCollectibles()
end
