local function testMethod(name, func)
    addResult("--- Testing: " .. name .. " ---", Color3.fromRGB(100, 200, 255))
    local success, err = pcall(func)
    if success then
        addResult("✓ " .. name .. " - SUCCESS", Color3.fromRGB(100, 255, 100))
    else
        addResult("✗ " .. name .. " - FAILED: " .. tostring(err), Color3.fromRGB(255, 100, 100))
    end
    task.wait(0.1)
end

local function findAllCollectibles()
    local results = {}
    
    -- Method 1: Internal table from getfenv
    local success, env = pcall(function()
        return getfenv(0)
    end)
    if success and env then
        if env.collectibles then
            for id, record in pairs(env.collectibles) do
                if type(record) == "table" then
                    table.insert(results, {id = id, data = record, source = "getfenv(0).collectibles"})
                end
            end
        end
        if env.v_u_46 then
            for id, record in pairs(env.v_u_46) do
                if type(record) == "table" then
                    table.insert(results, {id = id, data = record, source = "getfenv(0).v_u_46"})
                end
            end
        end
    end
    
    -- Method 2: Global collectibles
    local success, global = pcall(function()
        return _G.collectibles
    end)
    if success and global then
        for id, record in pairs(global) do
            if type(record) == "table" then
                table.insert(results, {id = id, data = record, source = "_G.collectibles"})
            end
        end
    end
    
    -- Method 3: Find in workspace
    local clientCollectibles = Workspace:FindFirstChild("ClientCollectibles")
    if clientCollectibles then
        for _, child in pairs(clientCollectibles:GetDescendants()) do
            if child:IsA("Model") or child:IsA("BasePart") then
                local id = child:GetAttribute("CollectibleId") or child.Name
                if id and id ~= "" then
                    local pos
                    if child:IsA("Model") then
                        local root = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Head") or child:FindFirstChild("Torso")
                        if root then pos = root.Position end
                        if not pos then pos = child:GetPivot().Position end
                    else
                        pos = child.Position
                    end
                    table.insert(results, {id = id, data = {Position = pos}, source = "Workspace.ClientCollectibles"})
                end
            end
        end
    end
    
    -- Method 4: Search entire workspace
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") or v:IsA("BasePart") then
            local id = v:GetAttribute("CollectibleId") or v.Name
            if id and id ~= "" and not string.match(id, "Part") and not string.match(id, "Base") then
                local pos
                if v:IsA("Model") then
                    local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head") or v:FindFirstChild("Torso")
                    if root then pos = root.Position end
                    if not pos then pos = v:GetPivot().Position end
                else
                    pos = v.Position
                end
                if pos then
                    table.insert(results, {id = id, data = {Position = pos}, source = "Workspace.Full"})
                end
            end
        end
    end
    
    -- Method 5: ReplicatedStorage
    local mogOrDie = ReplicatedStorage:FindFirstChild("MogOrDie")
    if mogOrDie then
        local templates = mogOrDie:FindFirstChild("MogOrDieCollectibleTemplates")
        if templates then
            for _, child in pairs(templates:GetDescendants()) do
                if child:IsA("Model") or child:IsA("BasePart") then
                    local id = child:GetAttribute("CollectibleType") or child.Name
                    if id and id ~= "" then
                        table.insert(results, {id = id, data = {template = true}, source = "ReplicatedStorage.Templates"})
                    end
                end
            end
        end
    end
    
    return results
end

local function testRemoteEvents()
    local mogOrDie = ReplicatedStorage:FindFirstChild("MogOrDie")
    if not mogOrDie then return end
    
    local collectibleStream = mogOrDie:FindFirstChild("CollectibleStream")
    if collectibleStream then
        addResult("Found CollectibleStream remote event", Color3.fromRGB(100, 255, 100))
        return collectibleStream
    end
    return nil
end

local function testFireServer()
    local stream = testRemoteEvents()
    if not stream then return end
    
    local ids = findAllCollectibles()
    if #ids > 0 then
        local testId = ids[1].id
        addResult("Testing FireServer with ID: " .. tostring(testId), Color3.fromRGB(255, 200, 100))
        local success, err = pcall(function()
            stream:FireServer("collect", testId)
        end)
        if success then
            addResult("✓ FireServer succeeded for ID: " .. tostring(testId), Color3.fromRGB(100, 255, 100))
        else
            addResult("✗ FireServer failed: " .. tostring(err), Color3.fromRGB(255, 100, 100))
        end
    end
end

local function testAllFireMethods()
    local stream = testRemoteEvents()
    if not stream then return end
    
    local ids = findAllCollectibles()
    local testIds = {}
    for i = 1, math.min(5, #ids) do
        table.insert(testIds, ids[i].id)
    end
    
    for _, id in pairs(testIds) do
        -- Method 1: Direct string
        addResult("Testing method 1: collect, " .. tostring(id), Color3.fromRGB(200, 200, 255))
        local success, err = pcall(function()
            stream:FireServer("collect", id)
        end)
        addResult(success and "✓ Success" or "✗ " .. tostring(err), success and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100))
        task.wait(0.1)
        
        -- Method 2: CollectibleId as number
        addResult("Testing method 2: collect, " .. tostring(id), Color3.fromRGB(200, 200, 255))
        local success, err = pcall(function()
            stream:FireServer("collect", tonumber(id))
        end)
        addResult(success and "✓ Success" or "✗ " .. tostring(err), success and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100))
        task.wait(0.1)
        
        -- Method 3: With position
        local pos = Vector3.new(0, 0, 0)
        addResult("Testing method 3: collect, " .. tostring(id) .. ", " .. tostring(pos), Color3.fromRGB(200, 200, 255))
        local success, err = pcall(function()
            stream:FireServer("collect", id, pos)
        end)
        addResult(success and "✓ Success" or "✗ " .. tostring(err), success and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100))
        task.wait(0.1)
    end
end

local function testGetAllIds()
    local ids = findAllCollectibles()
    addResult("Found " .. #ids .. " collectible entries", Color3.fromRGB(100, 200, 255))
    
    local idMap = {}
    for _, item in pairs(ids) do
        if not idMap[item.id] then
            idMap[item.id] = 0
        end
        idMap[item.id] = idMap[item.id] + 1
    end
    
    addResult("Unique IDs: " .. #idMap, Color3.fromRGB(100, 200, 255))
    
    for id, count in pairs(idMap) do
        local sources = {}
        for _, item in pairs(ids) do
            if item.id == id then
                table.insert(sources, item.source)
            end
        end
        addResult("ID: " .. tostring(id) .. " (found in " .. table.concat(sources, ", ") .. ")", Color3.fromRGB(150, 150, 200))
    end
end

local function startTesting()
    statusText.Text = "Testing all methods..."
    task.wait(1)
    
    addResult("========================================", Color3.fromRGB(255, 255, 255))
    addResult("STARTING COMPREHENSIVE TEST", Color3.fromRGB(255, 200, 100))
    addResult("========================================", Color3.fromRGB(255, 255, 255))
    task.wait(0.5)
    
    testMethod("Find All Collectibles", function()
        local ids = findAllCollectibles()
        addResult("Found " .. #ids .. " total collectible entries", Color3.fromRGB(100, 255, 100))
        return true
    end)
    
    testMethod("Test Remote Event", function()
        local stream = testRemoteEvents()
        return stream ~= nil
    end)
    
    testMethod("Test FireServer Methods", testAllFireMethods)
    
    testMethod("Test Get All IDs", testGetAllIds)
    
    testMethod("Test Teleport to Collectible", function()
        local character = LocalPlayer.Character
        if not character then return false end
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then return false end
        
        local ids = findAllCollectibles()
        local found = false
        for _, item in pairs(ids) do
            if item.data and item.data.Position then
                local pos = item.data.Position
                if type(pos) == "Vector3" then
                    local tween = TweenService:Create(root, TweenInfo.new(0.1), {CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))})
                    tween:Play()
                    tween.Completed:Wait()
                    found = true
                    break
                end
            end
        end
        return found
    end)
    
    testMethod("Test Collect All Nearby", function()
        local character = LocalPlayer.Character
        if not character then return false end
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then return false end
        
        local stream = testRemoteEvents()
        if not stream then return false end
        
        local ids = findAllCollectibles()
        local count = 0
        for _, item in pairs(ids) do
            if item.data and item.data.Position then
                local pos = item.data.Position
                if type(pos) == "Vector3" then
                    local dist = (pos - root.Position).Magnitude
                    if dist < 100 then
                        stream:FireServer("collect", item.id)
                        count = count + 1
                        task.wait(0.01)
                    end
                end
            end
        end
        addResult("Attempted to collect " .. count .. " nearby items", Color3.fromRGB(100, 255, 100))
        return true
    end)
    
    addResult("========================================", Color3.fromRGB(255, 255, 255))
    addResult("TESTING COMPLETE", Color3.fromRGB(255, 200, 100))
    addResult("========================================", Color3.fromRGB(255, 255, 255))
    addResult("Copy all results from this window", Color3.fromRGB(255, 200, 100))
    addResult("Paste them back to get the final working script", Color3.fromRGB(255, 200, 100))
    addResult("========================================", Color3.fromRGB(255, 255, 255))
    
    statusText.Text = "Testing complete! Copy results below."
end

