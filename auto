local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

print("=== TELEPORT COLLECTOR STARTED ===")

while wait(0.5) do
    local character = LocalPlayer.Character
    if not character then 
        print("No character found")
        continue 
    end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then 
        print("No HumanoidRootPart found")
        continue 
    end
    
    local currentPos = rootPart.Position
    print("Current position:", currentPos)
    
    local clientCollectibles = Workspace:FindFirstChild("ClientCollectibles")
    if not clientCollectibles then
        print("ClientCollectibles not found in workspace")
        continue
    end
    
    local closest = nil
    local closestDist = 999999
    
    for _, child in pairs(clientCollectibles:GetDescendants()) do
        if child:IsA("Model") or child:IsA("BasePart") then
            local pos = nil
            
            if child:IsA("Model") then
                local root = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Head") or child:FindFirstChild("Torso")
                if root then 
                    pos = root.Position
                else
                    pos = child:GetPivot().Position
                end
            else
                pos = child.Position
            end
            
            if pos then
                local dist = (pos - currentPos).Magnitude
                if dist < closestDist and dist > 2 then
                    closestDist = dist
                    closest = {obj = child, pos = pos}
                    print("Found collectible at distance:", dist, "Position:", pos)
                end
            end
        end
    end
    
    if closest then
        print("Teleporting to:", closest.pos)
        rootPart.CFrame = CFrame.new(closest.pos + Vector3.new(0, 5, 0))
        print("Teleported!")
    else
        print("No collectibles found nearby")
    end
end
