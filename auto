local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local MogOrDie = ReplicatedStorage:WaitForChild("MogOrDie")
local CollectibleStream = MogOrDie:WaitForChild("CollectibleStream")

local COLLECT_RADIUS = 5000
local AUTO_COOLDOWN = 0.1
local STOP_AUTO_NAME = "StopAuto"

local StopAuto = LocalPlayer:FindFirstChild(STOP_AUTO_NAME)
if not StopAuto then
    StopAuto = Instance.new("BoolValue")
    StopAuto.Name = STOP_AUTO_NAME
    StopAuto.Value = false
    StopAuto.Parent = LocalPlayer
end

local lastFireTimes = {}
local collectedIds = {}

local function collectItem(id)
    if collectedIds[id] then
        return
    end
    
    local success, err = pcall(function()
        CollectibleStream:FireServer("collect", id)
    end)
    
    if success then
        collectedIds[id] = true
        task.delay(5, function()
            collectedIds[id] = nil
        end)
    end
end

RunService.RenderStepped:Connect(function()
    if StopAuto.Value then
        return
    end
    
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return
    end
    
    local playerPos = rootPart.Position
    local currentTime = os.clock()
    
    local success, collectibleTable = pcall(function()
        return getfenv(0) and getfenv(0).collectibles
    end)
    
    if not success or not collectibleTable then
        local workspaceCollectibles = workspace:FindFirstChild("ClientCollectibles")
        if workspaceCollectibles then
            for _, child in pairs(workspaceCollectibles:GetChildren()) do
                if child:IsA("Model") or child:IsA("Part") then
                    local distance = (child.Position - playerPos).Magnitude
                    if distance <= COLLECT_RADIUS then
                        local id = child:GetAttribute("CollectibleId") or child.Name
                        if id and not collectedIds[id] then
                            local lastFire = lastFireTimes[id] or 0
                            if currentTime - lastFire >= AUTO_COOLDOWN then
                                lastFireTimes[id] = currentTime
                                collectItem(id)
                            end
                        end
                    end
                end
            end
        end
        return
    end
    
    for id, record in pairs(collectibleTable) do
        if record and record.Position then
            local position = record.Position
            local distance = (position - playerPos).Magnitude
            
            if distance <= COLLECT_RADIUS and not collectedIds[id] then
                local lastFire = lastFireTimes[id] or 0
                if currentTime - lastFire >= AUTO_COOLDOWN then
                    lastFireTimes[id] = currentTime
                    collectItem(id)
                end
            end
        end
    end
end)

local function handleDiamondFrenzy()
    local ownerId = tonumber(LocalPlayer:GetAttribute("TutorialDiamondFrenzyOwnerUserId")) or 0
    if ownerId == LocalPlayer.UserId then
        AUTO_COOLDOWN = 0.05
    else
        AUTO_COOLDOWN = 0.1
    end
end

LocalPlayer:GetAttributeChangedSignal("TutorialDiamondFrenzyOwnerUserId"):Connect(handleDiamondFrenzy)
handleDiamondFrenzy()
