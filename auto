-- Auto Collect Script for MogOrDie - With Destroy Button
-- Place this in a LocalScript in StarterPlayerScripts

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

local MogOrDie = ReplicatedStorage:WaitForChild("MogOrDie")
local Config = require(MogOrDie:WaitForChild("Config"))
local CollectibleStream = MogOrDie:WaitForChild("CollectibleStream")

-- Configuration
local AUTO_COLLECT_ENABLED = false -- DEFAULT OFF
local TELEPORT_TO_COLLECTIBLES = true
local MAX_TELEPORT_DISTANCE = math.huge
local TELEPORT_DELAY = 0.05
local SAFE_TELEPORT_HEIGHT = 10

local collectibles = {}
local processingIds = {}
local lastTeleport = 0
local scriptDestroyed = false

-- Safe function to try collecting a collectible
local function tryCollect(collectibleId, position)
    if scriptDestroyed or not collectibleId or processingIds[collectibleId] then return end
    processingIds[collectibleId] = true
    
    pcall(function()
        if TELEPORT_TO_COLLECTIBLES and HumanoidRootPart and position then
            local distance = (position - HumanoidRootPart.Position).Magnitude
            if distance > 20 then
                local timeSinceLastTeleport = os.clock() - lastTeleport
                if timeSinceLastTeleport < TELEPORT_DELAY then
                    task.wait(TELEPORT_DELAY - timeSinceLastTeleport)
                end
                
                local teleportPosition = position + Vector3.new(0, SAFE_TELEPORT_HEIGHT, 0)
                HumanoidRootPart.CFrame = CFrame.new(teleportPosition)
                lastTeleport = os.clock()
                
                task.wait(0.1)
            end
        end
        
        CollectibleStream:FireServer("collect", collectibleId)
    end)
    
    task.delay(0.3, function()
        if not scriptDestroyed then
            processingIds[collectibleId] = nil
        end
    end)
end

-- Function to collect ALL known collectibles
local function collectAllCollectibles()
    if scriptDestroyed or not AUTO_COLLECT_ENABLED then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local sortedCollectibles = {}
    for id, data in pairs(collectibles) do
        if data and data.Position then
            local distance = (data.Position - rootPart.Position).Magnitude
            table.insert(sortedCollectibles, {
                Id = id,
                Position = data.Position,
                Distance = distance
            })
        end
    end
    
    table.sort(sortedCollectibles, function(a, b)
        return a.Distance < b.Distance
    end)
    
    for _, collectible in ipairs(sortedCollectibles) do
        if scriptDestroyed then break end
        if collectible and collectible.Id and collectible.Position then
            tryCollect(collectible.Id, collectible.Position)
            task.wait(0.01)
        end
    end
end

-- Event connection
local eventConnection
eventConnection = CollectibleStream.OnClientEvent:Connect(function(event, ...)
    if scriptDestroyed then 
        eventConnection:Disconnect()
        return 
    end
    
    pcall(function()
        if event == "chunks" then
            local args = {...}
            local chunkData = args[1]
            if chunkData then
                for chunkKey, chunkCollectibles in pairs(chunkData) do
                    if chunkCollectibles then
                        for _, collectibleData in ipairs(chunkCollectibles) do
                            if collectibleData and #collectibleData >= 5 then
                                local id = collectibleData[1]
                                local position = Vector3.new(collectibleData[3], collectibleData[4], collectibleData[5])
                                collectibles[id] = {
                                    Position = position,
                                    Type = collectibleData[2] or "Unknown",
                                    ChunkKey = chunkKey
                                }
                                
                                if AUTO_COLLECT_ENABLED then
                                    tryCollect(id, position)
                                end
                            end
                        end
                    end
                end
            end
        elseif event == "spawned" then
            local args = {...}
            local chunkKey = args[1]
            local collectibleData = args[2]
            if collectibleData and #collectibleData >= 5 then
                local id = collectibleData[1]
                local position = Vector3.new(collectibleData[3], collectibleData[4], collectibleData[5])
                collectibles[id] = {
                    Position = position,
                    Type = collectibleData[2] or "Unknown",
                    ChunkKey = chunkKey
                }
                
                if AUTO_COLLECT_ENABLED then
                    tryCollect(id, position)
                end
            end
        elseif event == "despawned" then
            local args = {...}
            local id = args[1]
            if id then
                collectibles[id] = nil
                processingIds[id] = nil
            end
        elseif event == "moved" then
            local args = {...}
            local id = args[1]
            local newPosition = args[2]
            if id and newPosition and typeof(newPosition) == "Vector3" then
                if collectibles[id] then
                    collectibles[id].Position = newPosition
                    
                    if AUTO_COLLECT_ENABLED then
                        tryCollect(id, newPosition)
                    end
                end
            end
        elseif event == "collected" then
            local args = {...}
            local id = args[1]
            if id then
                collectibles[id] = nil
                processingIds[id] = nil
            end
        end
    end)
end)

-- Aggressive collection loop
local scanLoop
scanLoop = task.spawn(function()
    while not scriptDestroyed do
        task.wait(0.1)
        pcall(function()
            if AUTO_COLLECT_ENABLED then
                collectAllCollectibles()
            end
        end)
    end
end)

-- Ultra aggressive collection loop
local aggressiveLoop
aggressiveLoop = task.spawn(function()
    while not scriptDestroyed do
        task.wait(0.05)
        pcall(function()
            if AUTO_COLLECT_ENABLED and next(collectibles) then
                for id, data in pairs(collectibles) do
                    if scriptDestroyed then break end
                    if data and data.Position then
                        tryCollect(id, data.Position)
                    end
                end
            end
        end)
    end
end)

-- Character respawn handling
local characterConnection
characterConnection = LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    if scriptDestroyed then
        characterConnection:Disconnect()
        return
    end
    
    pcall(function()
        Character = newCharacter
        HumanoidRootPart = newCharacter:WaitForChild("HumanoidRootPart")
        task.wait(1)
        if AUTO_COLLECT_ENABLED then
            collectAllCollectibles()
        end
    end)
end)

