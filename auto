local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local CollectibleStream = ReplicatedStorage:WaitForChild("MogOrDie"):WaitForChild("CollectibleStream")

local COLLECT_RADIUS = 50
local TELEPORT_RADIUS = 5000
local AUTO_COOLDOWN = 0.01
local MIN_DISTANCE = 3

local collectedIds = {}
local collectibleTable = nil

local function getCollectibleTable()
    if collectibleTable then return collectibleTable end
    
    local success, result = pcall(function()
        local env = getfenv(0)
        if env and env.collectibles then
            return env.collectibles
        end
        local script = debug and debug.getinfo(1, "S").source
        if script then
            for i = 1, 10 do
                local func = debug.getinfo(i, "f")
                if func and func.func then
                    local env2 = getfenv(func.func)
                    if env2 and env2.collectibles then
                        return env2.collectibles
                    end
                end
            end
        end
        return nil
    end)
    
    if success and result then
        collectibleTable = result
        return collectibleTable
    end
    
    return nil
end

local function getPositionFromId(id)
    local table = getCollectibleTable()
    if table and table[id] then
        local record = table[id]
        if record then
            if type(record) == "table" and record.Position then
                return record.Position
            end
        end
    end
    
    local clientCollectibles = Workspace:FindFirstChild("ClientCollectibles")
    if clientCollectibles then
        for _, child in pairs(clientCollectibles:GetDescendants()) do
            if child:IsA("Model") or child:IsA("BasePart") then
                local cid = child:GetAttribute("CollectibleId") or child.Name
                if cid == id then
                    if child:IsA("Model") then
                        local root = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Head") or child:FindFirstChild("Torso")
                        if root then return root.Position end
                        return child:GetPivot().Position
                    else
                        return child.Position
                    end
                end
            end
        end
    end
    
    return nil
end

local function collectItem(id)
    if collectedIds[id] then return end
    collectedIds[id] = true
    CollectibleStream:FireServer("collect", id)
    task.wait(0.005)
end

local function getAllCollectibleIds()
    local ids = {}
    local table = getCollectibleTable()
    if table then
        for id, record in pairs(table) do
            if record and type(record) == "table" and record.Position then
                table.insert(ids, {id = id, position = record.Position})
            end
        end
    end
    
    local clientCollectibles = Workspace:FindFirstChild("ClientCollectibles")
    if clientCollectibles then
        for _, child in pairs(clientCollectibles:GetDescendants()) do
            if child:IsA("Model") or child:IsA("BasePart") then
                local id = child:GetAttribute("CollectibleId") or child.Name
                if id and id ~= "" and not collectedIds[id] then
                    local pos
                    if child:IsA("Model") then
                        local root = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Head") or child:FindFirstChild("Torso")
                        if root then pos = root.Position end
                        if not pos then pos = child:GetPivot().Position end
                    else
                        pos = child.Position
                    end
                    if pos then
                        table.insert(ids, {id = id, position = pos})
                    end
                end
            end
        end
    end
    
    return ids
end

local function getClosestCollectible(pos)
    local ids = getAllCollectibleIds()
    local closest = nil
    local closestDist = TELEPORT_RADIUS
    
    for _, item in pairs(ids) do
        if not collectedIds[item.id] then
            local dist = (item.position - pos).Magnitude
            if dist < closestDist and dist > MIN_DISTANCE then
                closestDist = dist
                closest = item
            end
        end
    end
    
    return closest, closestDist
end

local function teleportTo(position)
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Landed)
        humanoid.AutoRotate = false
    end
    
    local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(position)})
    tween:Play()
    tween.Completed:Wait()
    
    if humanoid then
        humanoid.AutoRotate = true
    end
end

local function teleportCollect()
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local currentPos = rootPart.Position
    local closest, dist = getClosestCollectible(currentPos)
    
    if closest then
        local targetPos = closest.position + Vector3.new(0, 3, 0)
        teleportTo(targetPos)
        task.wait(0.05)
        collectItem(closest.id)
        task.wait(0.1)
        return true
    end
    
    return false
end

local function collectNearby()
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local pos = rootPart.Position
    local ids = getAllCollectibleIds()
    
    for _, item in pairs(ids) do
        if not collectedIds[item.id] then
            local dist = (item.position - pos).Magnitude
            if dist <= COLLECT_RADIUS then
                collectItem(item.id)
            end
        end
    end
end

while wait(0.05) do
    collectNearby()
    local success = teleportCollect()
    if not success then
        task.wait(1)
    end
end
