local function addResult(text, color)
    local colorStr = ""
    if color then
        colorStr = string.format("%.3f, %.3f, %.3f", color.R, color.G, color.B)
    end
    table.insert(results, text)
    textBox.Text = table.concat(results, "\n")
    textBox.CursorPosition = -1
end

local function testMethod(name, func)
    addResult("--- " .. name .. " ---")
    local success, err = pcall(func)
    if success then
        addResult("✓ " .. name .. " - SUCCESS")
    else
        addResult("✗ " .. name .. " - FAILED: " .. tostring(err))
    end
    task.wait(0.05)
end

local function findAllCollectibles()
    local results = {}
    
    local success, env = pcall(function()
        return getfenv(0)
    end)
    if success and env then
        if env.collectibles then
            for id, record in pairs(env.collectibles) do
                if type(record) == "table" then
                    table.insert(results, {id = id, data = record, source = "getfenv(0).collectibles"})
                end
            end
        end
        if env.v_u_46 then
            for id, record in pairs(env.v_u_46) do
                if type(record) == "table" then
                    table.insert(results, {id = id, data = record, source = "getfenv(0).v_u_46"})
                end
            end
        end
    end
    
    local success, global = pcall(function()
        return _G.collectibles
    end)
    if success and global then
        for id, record in pairs(global) do
            if type(record) == "table" then
                table.insert(results, {id = id, data = record, source = "_G.collectibles"})
            end
        end
    end
    
    local clientCollectibles = Workspace:FindFirstChild("ClientCollectibles")
    if clientCollectibles then
        for _, child in pairs(clientCollectibles:GetDescendants()) do
            if child:IsA("Model") or child:IsA("BasePart") then
                local id = child:GetAttribute("CollectibleId") or child.Name
                if id and id ~= "" then
                    local pos
                    if child:IsA("Model") then
                        local root = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Head") or child:FindFirstChild("Torso")
                        if root then pos = root.Position end
                        if not pos then pos = child:GetPivot().Position end
                    else
                        pos = child.Position
                    end
                    table.insert(results, {id = id, data = {Position = pos}, source = "Workspace.ClientCollectibles"})
                end
            end
        end
    end
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") or v:IsA("BasePart") then
            local id = v:GetAttribute("CollectibleId") or v.Name
            if id and id ~= "" and not string.match(id, "Part") and not string.match(id, "Base") then
                local pos
                if v:IsA("Model") then
                    local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head") or v:FindFirstChild("Torso")
                    if root then pos = root.Position end
                    if not pos then pos = v:GetPivot().Position end
                else
                    pos = v.Position
                end
                if pos then
                    table.insert(results, {id = id, data = {Position = pos}, source = "Workspace.Full"})
                end
            end
        end
    end
    
    return results
end

local function testRemoteEvents()
    local mogOrDie = ReplicatedStorage:FindFirstChild("MogOrDie")
    if not mogOrDie then return nil end
    
    local collectibleStream = mogOrDie:FindFirstChild("CollectibleStream")
    if collectibleStream then
        addResult("✓ Found CollectibleStream remote event")
        return collectibleStream
    end
    addResult("✗ CollectibleStream not found")
    return nil
end

local function testFireServerMethods()
    local stream = testRemoteEvents()
    if not stream then return end
    
    local ids = findAllCollectibles()
    if #ids == 0 then
        addResult("✗ No collectibles found to test with")
        return
    end
    
    local testId = ids[1].id
    addResult("Testing FireServer with ID: " .. tostring(testId))
    
    local success, err = pcall(function()
        stream:FireServer("collect", testId)
    end)
    if success then
        addResult("✓ FireServer succeeded for ID: " .. tostring(testId))
    else
        addResult("✗ FireServer failed: " .. tostring(err))
    end
    
    task.wait(0.1)
    
    local success, err = pcall(function()
        stream:FireServer("collect", tonumber(testId))
    end)
    if success then
        addResult("✓ FireServer with number worked: " .. tostring(testId))
    else
        addResult("✗ FireServer with number failed: " .. tostring(err))
    end
end

local function testGetAllIds()
    local ids = findAllCollectibles()
    addResult("Found " .. #ids .. " total collectible entries")
    
    local idMap = {}
    for _, item in pairs(ids) do
        if not idMap[item.id] then
            idMap[item.id] = 0
        end
        idMap[item.id] = idMap[item.id] + 1
    end
    
    addResult("Unique IDs: " .. #idMap)
    
    local sampleIds = {}
    local count = 0
    for id, _ in pairs(idMap) do
        if count < 10 then
            table.insert(sampleIds, id)
            count = count + 1
        end
    end
    
    addResult("Sample IDs: " .. table.concat(sampleIds, ", "))
end

local function testTeleportCollect()
    local character = LocalPlayer.Character
    if not character then 
        addResult("✗ No character found")
        return 
    end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then 
        addResult("✗ No HumanoidRootPart found")
        return 
    end
    
    local ids = findAllCollectibles()
    local found = false
    
    for _, item in pairs(ids) do
        if item.data and item.data.Position then
            local pos = item.data.Position
            if type(pos) == "Vector3" then
                local tween = TweenService:Create(root, TweenInfo.new(0.1), {CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))})
                tween:Play()
                tween.Completed:Wait()
                addResult("✓ Teleported to position: " .. tostring(pos))
                found = true
                break
            end
        end
    end
    
    if not found then
        addResult("✗ No valid position found to teleport to")
    end
end

local function testCollectNearby()
    local character = LocalPlayer.Character
    if not character then 
        addResult("✗ No character found")
        return 
    end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then 
        addResult("✗ No HumanoidRootPart found")
        return 
    end
    
    local stream = testRemoteEvents()
    if not stream then return end
    
    local ids = findAllCollectibles()
    local count = 0
    
    for _, item in pairs(ids) do
        if item.data and item.data.Position then
            local pos = item.data.Position
            if type(pos) == "Vector3" then
                local dist = (pos - root.Position).Magnitude
                if dist < 100 then
                    stream:FireServer("collect", item.id)
                    count = count + 1
                    task.wait(0.01)
                end
            end
        end
    end
    
    addResult("Attempted to collect " .. count .. " nearby items")
end

local function startTesting()
    statusText.Text = "Status: Testing in progress..."
    addResult("========================================")
